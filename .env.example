# Copy to .env and fill in. Never commit .env.
# AI providers: "gemini" (free tier, key from aistudio.google.com) or "openai"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# embedding tokens per minute (Gemini free tier: 30000); 0 = unlimited
EMBEDDING_TPM=30000
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# tried in order when the main model is overloaded (free tier); empty = no fallback
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash
GEMINI_API_KEY=
# OPENAI_API_KEY is only needed if a provider is "openai"
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # backend + ai-service only
SUPABASE_ANON_KEY=            # frontend
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=change-me-to-a-long-random-string

# Frontend (Vite only exposes VITE_* vars to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
